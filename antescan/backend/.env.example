# Flask
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-me-in-production-32-bytes-please
JWT_SECRET_KEY=change-this-jwt-secret-key-too-please

# Database
DATABASE_URL=sqlite:///antescan.db

# Auth
JWT_ACCESS_TOKEN_EXPIRES_HOURS=12
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# SMS — Africa's Talking
AT_API_KEY=
AT_USERNAME=sandbox
AT_SENDER_ID=AnteScan
SMS_DRY_RUN=true

# Paths
DATA_DIR=data
DATASETS_DIR=data/datasets
ML_MODELS_DIR=data/ml_models
EXPORTS_DIR=data/exports
UPLOADS_DIR=data/uploads

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Server
PORT=5000
